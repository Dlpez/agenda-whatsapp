# Copia este archivo como .env y rellena. En Render, pon estas mismas variables en "Environment".

# --- WhatsApp Cloud API (developers.facebook.com) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=inventa-una-frase-secreta
WA_APP_SECRET=
GRAPH_VERSION=v23.0

# Tu WhatsApp personal, formato internacional sin "+" ni espacios (Chile: 569XXXXXXXX)
OWNER_WHATSAPP=569XXXXXXXX

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Transcripción de audios (console.groq.com, plan gratuito) ---
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Google Calendar ---
# Cliente OAuth tipo "Aplicación web" con redirección https://TU-APP.onrender.com/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lo entrega la página https://TU-APP.onrender.com/google/login (o scripts/google_auth.py)
GOOGLE_TOKEN_JSON=
CALENDAR_ID=primary
TIMEZONE=America/Santiago
DEFAULT_DURATION_MIN=60

# --- Recordatorios por WhatsApp ---
REMINDER_MINUTES=60
REMINDER_TEMPLATE=recordatorio_reunion
REMINDER_TEMPLATE_LANG=es
REMIND_INVITEES=false
CRON_SECRET=inventa-otra-clave-larga

# Opcional: contactos como JSON en vez de contacts.json
# CONTACTS_JSON=[{"nombre":"Juan","email":"juan@x.com"}]
